generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id         String   @id @default("main")
  schoolName String
  shortName  String
  longName   String
  logo       String?
  favicon    String?
  facebook   String?
  instagram  String?
  youtube    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Staff {
  id          String        @id @default(cuid())
  name        String
  category    StaffCategory @default(TEACHER)
  position    String
  identityNo  String?
  education   String?
  image       String?
  imageAlt    String?
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive, category, sortOrder])
}

model News {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  category    String
  excerpt     String     @db.Text
  content     String     @db.LongText
  image       String?
  imageAlt    String?
  author      String?
  status      NewsStatus @default(DRAFT)
  isFeatured  Boolean    @default(false)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}

model HomeHero {
  id                String   @id @default("main")
  headlineTop       String
  headlineHighlight String
  headlineBottom    String
  description       String   @db.Text
  primaryLabel      String
  primaryUrl        String
  secondaryLabel    String
  secondaryUrl      String
  backgroundImage   String?
  stats             Json
  features          Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RegistrationSettings {
  id                   String   @id @default("main")
  isOpen               Boolean  @default(true)
  showHomeSection      Boolean  @default(true)
  academicYear         String
  currentWave          String
  quota                String
  promoTitle           String
  promoDescription     String   @db.Text
  ctaLabel             String
  ctaDestination       String
  whatsappNumber       String?
  requirements         Json
  steps                Json
  fees                 Json
  feeNote              String?  @db.Text
  bankName             String?
  bankAccount          String?
  bankHolder           String?
  brochureFile         String?
  registrationFormFile String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CurriculumSettings {
  id                  String   @id @default("main")
  title               String
  introduction        String   @db.Text
  approachTitle       String
  approachDescription String   @db.Text
  image               String?
  methods             Json
  schedule            Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model EducationProgram {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  eyebrow      String
  description  String   @db.Text
  age          String
  schedule     String
  capacity     String
  teacherRatio String
  highlights   Json
  image        String?
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, isFeatured, sortOrder])
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  recipient   String
  category    String
  level       String
  year        Int
  description String   @db.Text
  image       String?
  imageAlt    String?
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, isFeatured, year, sortOrder])
}

model VisionMissionSettings {
  id                String   @id @default("main")
  pageTitle         String
  introduction      String   @db.Text
  visionTitle       String
  visionDescription String   @db.Text
  visionPoints      Json
  missions          Json
  goals             Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SchoolContact {
  id                     String   @id @default("main")
  sectionTitle           String
  sectionDescription     String   @db.Text
  address                String   @db.Text
  district               String
  regency                String
  postalCode             String
  phone                  String
  whatsapp               String
  email                  String
  serviceHours           String
  mapEmbedUrl            String   @db.Text
  mapDirectionsUrl       String   @db.Text
  whatsappDefaultMessage String   @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model SchoolProfile {
  id                String   @id @default("main")
  pageTitle         String
  introduction      String   @db.Text
  principalName     String
  principalPhoto    String?
  welcomeMessage    String   @db.LongText
  npsn              String
  accreditation     String
  foundedYear       String
  operationalPermit String
  permitIssuer      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SchoolHistory {
  id           String   @id @default("main")
  pageTitle    String
  introduction String   @db.Text
  storyTitle   String
  story        String   @db.LongText
  image        String?
  milestones   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FacilitySettings {
  id           String   @id @default("main")
  pageTitle    String
  introduction String   @db.Text
  facilities   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

enum StaffCategory {
  PRINCIPAL
  TEACHER
  STAFF
}
